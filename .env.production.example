# Copy this to .env.production on the EC2 instance — never commit .env.production
RESUME_ID=resume
LLM_PROVIDER=claude
MODEL_NAME=claude-sonnet-4-6
CLAUDE_API_KEY=your_anthropic_api_key_here

# If using OpenAI-compatible provider instead:
# LLM_PROVIDER=external
# EXTERNAL_LLM_API_KEY=your_api_key_here
# EXTERNAL_LLM_BASE_URL=https://api.openai.com/v1
# MODEL_NAME=gpt-4.1
